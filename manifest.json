{
  "manifest_version": 3,
  "name": "PromptPrint – AI Carbon Tracker",
  "short_name": "PromptPrint",
  "version": "1.3.0",
  "description": "Tracks your AI chatbot usage on the platforms you choose, estimates its electricity, carbon and cooling water, and suggests lower-impact alternatives.",
  "permissions": [
    "storage",
    "scripting",
    "favicon"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PromptPrint",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
